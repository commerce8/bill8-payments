  "components": {
    "schemas": {
      "Channel": {
        "type": "object",
        "description": "A runtime-registered settlement channel with its capability matrix.",
        "required": [
          "id",
          "env_id",
          "name",
          "label",
          "methods",
          "regions",
          "recurring",
          "mode",
          "enabled",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "enabled": {
            "type": "boolean",
            "description": "Enabled state."
          },
          "env_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owning tenant environment."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Channel id."
          },
          "label": {
            "type": "string",
            "description": "Display label."
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Supported method types (routing input)."
          },
          "mode": {
            "type": "string",
            "description": "Channel mode (`live` / `test`)."
          },
          "name": {
            "type": "string",
            "description": "Machine name (`finance8` / `simulation` / external adapters)."
          },
          "recurring": {
            "type": "boolean",
            "description": "Whether the channel supports recurring charges."
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Supported regions (routing input)."
          }
        }
      },
      "Charge": {
        "type": "object",
        "description": "An immutable money capture routed through a settlement channel.",
        "required": [
          "id",
          "env_id",
          "amount",
          "amount_refunded",
          "currency",
          "status",
          "created_at"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Amount as a JSON string on the wire."
          },
          "amount_refunded": {
            "type": "string",
            "description": "Amount already refunded, as a JSON string (compensating records only;\n`amount` itself is append-only and never changes)."
          },
          "application_fee_amount": {
            "type": [
              "string",
              "null"
            ],
            "description": "Platform fee taken on the charge, as a JSON string."
          },
          "balance_transaction_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Ledger balance-transaction reference proving the money movement."
          },
          "channel_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
